# LLM provider: omlx, openai, or anthropic
LLM_PROVIDER=omlx
OMLX_ENDPOINT=http://localhost:11434
OMLX_MODEL=qwen2.5-coder:7b

# For remote providers:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Chunking (default: header-split — winner of chunking experiment)
CHUNKING_STRATEGY=header-split
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# Vector store path
CHROMA_PATH=./data/chroma_db

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
