# Discord bot token (required for `oncall-rag discord`)
# DISCORD_BOT_TOKEN=your_token_here

# LLM provider: omlx, openai, or anthropic
LLM_PROVIDER=omlx
OMLX_ENDPOINT=http://localhost:8000
OMLX_MODEL=Llama-3.2-3B-Instruct-4bit
OMLX_API_KEY=omlx-test

# For remote providers:
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# Chunking (default: header-split — winner of chunking experiment)
CHUNKING_STRATEGY=header-split
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# Vector store path
CHROMA_PATH=./data/chroma_db

# Embedding model
EMBEDDING_MODEL=all-MiniLM-L6-v2
